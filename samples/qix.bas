10 REM ==============================
20 REM  QIX-LIKE TERRITORY GAME
30 REM  claim 75% of the field to win
40 REM  keys: W/A/S/D move, Q quit
50 REM  touch: tap where to go
60 REM ==============================
70 CLS
80 CW=24 : CH=18 : CS=10 : OX=40 : OY=30
90 DIM F(23,17) : DIM ST(450)
100 TI=(CW-2)*(CH-2) : CN=0 : LV=3 : ET=0
110 REM --- border ring starts claimed ---
120 FOR X=0 TO CW-1 : F(X,0)=1 : F(X,CH-1)=1 : NEXT X
130 FOR Y=0 TO CH-1 : F(0,Y)=1 : F(CW-1,Y)=1 : NEXT Y
140 REM --- draw the field ---
150 FOR Y=0 TO CH-1
160 FOR X=0 TO CW-1
170 CX=X : CY=Y : GOSUB *DRAWC
180 NEXT X
190 NEXT Y
200 PX=12 : PY=17 : TA=0
210 EX=12 : EY=5 : DX1=1 : DY1=1
220 GOSUB *HUD
230 REM ============ main loop ============
240 *MAIN
250 VX=0 : VY=0
260 GET K
270 IF K=87 OR K=119 THEN VY=-1
280 IF K=83 OR K=115 THEN VY=1
290 IF K=65 OR K=97 THEN VX=-1
300 IF K=68 OR K=100 THEN VX=1
310 IF K=81 OR K=113 THEN END
320 IF K=0 AND TOUCH(2)=1 THEN GOSUB *TSTEER
330 IF VX=0 AND VY=0 THEN GOTO *ENEMY
340 NX=PX+VX : NY=PY+VY
350 IF NX<0 OR NX>CW-1 OR NY<0 OR NY>CH-1 THEN GOTO *ENEMY
360 IF F(NX,NY)=2 THEN GOTO *ENEMY
370 CX=PX : CY=PY : GOSUB *DRAWC : REM restore old player cell
380 IF F(NX,NY)=0 THEN F(NX,NY)=2 : TA=1
390 PX=NX : PY=NY
400 IF F(PX,PY)=1 AND TA=1 THEN GOSUB *CLOSE
410 REM ---- enemy (moves every 2nd frame) ----
420 *ENEMY
430 ET=1-ET : IF ET=0 THEN GOTO *DRAW
440 CX=EX : CY=EY : GOSUB *DRAWC : REM erase enemy
450 IF F(EX+DX1,EY)<>0 THEN DX1=-DX1
460 IF F(EX,EY+DY1)<>0 THEN DY1=-DY1
470 IF F(EX+DX1,EY+DY1)=0 THEN EX=EX+DX1 : EY=EY+DY1
480 IF F(EX+1,EY)=2 OR F(EX-1,EY)=2 OR F(EX,EY+1)=2 OR F(EX,EY-1)=2 THEN GOSUB *DEATH
490 *DRAW
500 LINE (OX+EX*CS,OY+EY*CS)-(OX+EX*CS+CS-1,OY+EY*CS+CS-1),4,BF
510 LINE (OX+PX*CS,OY+PY*CS)-(OX+PX*CS+CS-1,OY+PY*CS+CS-1),15,BF
520 WAIT 25
530 GOTO *MAIN
540 REM ---- enemy hit the trail ----
550 *DEATH
560 PLAY "O3C8C8"
570 FOR Y=1 TO CH-2
580 FOR X=1 TO CW-2
590 IF F(X,Y)=2 THEN F(X,Y)=0 : CX=X : CY=Y : GOSUB *DRAWC
600 NEXT X
610 NEXT Y
620 CX=PX : CY=PY : GOSUB *DRAWC
630 LV=LV-1 : PX=12 : PY=17 : TA=0
640 GOSUB *HUD
650 IF LV=0 THEN LOCATE 14,1 : PRINT "GAME OVER" : END
660 RETURN
670 REM ---- trail closed: claim area ----
680 *CLOSE
690 TA=0
700 FOR Y=1 TO CH-2
710 FOR X=1 TO CW-2
720 IF F(X,Y)=2 THEN F(X,Y)=1 : CX=X : CY=Y : GOSUB *DRAWC
730 NEXT X
740 NEXT Y
750 REM flood-fill from the enemy: mark reachable empty cells 3
760 F(EX,EY)=3 : ST(0)=EX*100+EY : SP=1
770 REPEAT
780 SP=SP-1 : P=ST(SP) : X=INT(P/100) : Y=P-X*100
790 IF F(X+1,Y)=0 THEN F(X+1,Y)=3 : ST(SP)=(X+1)*100+Y : SP=SP+1
800 IF F(X-1,Y)=0 THEN F(X-1,Y)=3 : ST(SP)=(X-1)*100+Y : SP=SP+1
810 IF F(X,Y+1)=0 THEN F(X,Y+1)=3 : ST(SP)=X*100+Y+1 : SP=SP+1
820 IF F(X,Y-1)=0 THEN F(X,Y-1)=3 : ST(SP)=X*100+Y-1 : SP=SP+1
830 UNTIL SP=0
840 REM cells the enemy cannot reach become ours
850 CN=0
860 FOR Y=1 TO CH-2
870 FOR X=1 TO CW-2
880 IF F(X,Y)=0 THEN F(X,Y)=1 : CX=X : CY=Y : GOSUB *DRAWC
890 IF F(X,Y)=3 THEN F(X,Y)=0
900 IF F(X,Y)=1 THEN CN=CN+1
910 NEXT X
920 NEXT Y
930 PLAY "O5CE"
940 GOSUB *HUD
950 IF CN*100/TI>=75 THEN LOCATE 14,1 : PRINT "YOU WIN!" : END
960 RETURN
970 REM ---- draw cell CX,CY by its state ----
980 *DRAWC
990 CC=0
1000 IF F(CX,CY)=1 THEN CC=9
1010 IF F(CX,CY)=2 THEN CC=14
1020 LINE (OX+CX*CS,OY+CY*CS)-(OX+CX*CS+CS-1,OY+CY*CS+CS-1),CC,BF
1030 RETURN
1040 REM ---- score line ----
1050 *HUD
1060 PC=INT(CN*100/TI)
1070 LOCATE 1,1 : PRINT "CLAIMED:";PC;"%  LIVES:";LV;"  GOAL:75%"
1080 RETURN
1090 REM ---- steer toward the touch point ----
1100 *TSTEER
1110 TX=TOUCH(0)-(OX+PX*CS+5) : TY=TOUCH(1)-(OY+PY*CS+5)
1120 IF ABS(TX)>ABS(TY) THEN VX=SGN(TX) : VY=0 ELSE VX=0 : VY=SGN(TY)
1130 RETURN
