10 REM TILT - IMU (QMI8658) DE BALL WO KOROGASU
20 REM ACCEL(0)=X ACCEL(1)=Y  1G = 1000
30 CLS
40 X = 160 : Y = 120
50 VX = 0 : VY = 0
60 REM ---- MAIN LOOP ----
70 PSET (X, Y), 0
80 VX = VX + ACCEL(0) / 200
90 VY = VY + ACCEL(1) / 200
100 IF VX > 6 THEN VX = 6
110 IF VX < -6 THEN VX = -6
120 IF VY > 6 THEN VY = 6
130 IF VY < -6 THEN VY = -6
140 X = X + VX : Y = Y + VY
150 IF X < 1 THEN X = 1 : VX = -VX / 2
160 IF X > 318 THEN X = 318 : VX = -VX / 2
170 IF Y < 1 THEN Y = 1 : VY = -VY / 2
180 IF Y > 238 THEN Y = 238 : VY = -VY / 2
190 CIRCLE (X, Y), 4, 14
200 WAIT 20
210 PSET (X, Y), 0
220 CIRCLE (X, Y), 4, 0
230 GOTO 70
