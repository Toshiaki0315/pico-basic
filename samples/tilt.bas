10 REM TILT - KATAMUKETE BALL WO KOROGASU (IMU)
20 REM ---- JIKU NO MUKI (JIKKI DE KAKUNIN ZUMI) ----
30 REM   HIDARI HASHI WO AGERU (MIGI GA SAGARU) -> ACCEL(0) GA MAINASU
40 REM   TEMAE WO AGERU (OKU GA SAGARU)         -> ACCEL(1) GA PURASU
50 REM   YOTTE GAMEN ZAHYOU TOHA RYOUHOU HANTEN SURU
60 CLS
70 PRINT "KEEP THE BOARD LEVEL..."
80 REM ---- SUIHEI NO ATAI WO ZERO TEN TOSHITE KIOKU SURU ----
90 OX = 0 : OY = 0
100 FOR I = 1 TO 8
110 OX = OX + ACCEL(0) : OY = OY + ACCEL(1)
120 WAIT 50
130 NEXT I
140 OX = OX / 8 : OY = OY / 8
150 CLS
160 X = 160 : Y = 120 : VX = 0 : VY = 0
165 SYNC OFF
170 REM ---- MAIN LOOP ----
180 CIRCLE (X, Y), 4, 0
190 AX = -(ACCEL(0) - OX)
200 AY = -(ACCEL(1) - OY)
210 REM CHIISANA KATAMUKI HA MUSHI SURU
220 IF ABS(AX) < 40 THEN AX = 0
230 IF ABS(AY) < 40 THEN AY = 0
240 VX = VX + AX / 300
250 VY = VY + AY / 300
260 IF VX > 6 THEN VX = 6
270 IF VX < -6 THEN VX = -6
280 IF VY > 6 THEN VY = 6
290 IF VY < -6 THEN VY = -6
300 X = X + VX : Y = Y + VY
310 IF X < 5 THEN X = 5 : VX = -VX / 2
320 IF X > 314 THEN X = 314 : VX = -VX / 2
330 IF Y < 5 THEN Y = 5 : VY = -VY / 2
340 IF Y > 234 THEN Y = 234 : VY = -VY / 2
350 CIRCLE (X, Y), 4, 14
355 REM KESHITE KARA KAKINAOSHITA BUN WO MATOMETE DASU
356 SYNC
360 WAIT 20
370 GOTO 180
